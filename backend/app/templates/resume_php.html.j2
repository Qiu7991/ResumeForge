<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data: blob:; style-src 'unsafe-inline'; script-src 'nonce-{{ csp_nonce }}'; base-uri 'none'; form-action 'none'" />
<title>{{ resume.name }} - {{ resume.job_intent }} - 简历</title>
<style>
  /* PHP 后端模板：紫罗兰强调色、浅色块区块标题，适合 PHP / 后端开发岗位。 */
  :root {
    --text: #2b2640;
    --muted: #6f6890;
    --line: #ded9ee;
    --accent: #6c5ce7;
    --accent-soft: #f0edfd;
    --bg: #ffffff;
    --fs: calc({{ base_px }}px * var(--fit-scale, 1));
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    color: var(--text);
    background: var(--bg);
    font-size: var(--fs);
    line-height: 1.68;
    width: 210mm;
    height: {{ page_limit * 297 }}mm;
    padding: 14mm;
  }
  .header { display: flex; align-items: flex-start; gap: calc(var(--fs) * 1.5); border-bottom: 2px solid var(--accent); padding-bottom: calc(var(--fs) * 1); margin-bottom: calc(var(--fs) * 1.4); }
  .header-main { flex: 1; min-width: 0; }
  .header .name { font-size: calc(var(--fs) * 1.85); font-weight: 700; color: var(--accent); letter-spacing: 1px; }
  .name-extra { font-size: calc(var(--fs) * 0.95); font-weight: 400; color: var(--muted); }
  .header .intent { font-size: calc(var(--fs) * 1.05); color: var(--muted); margin-top: calc(var(--fs) * 0.28); }
  .header .contact { font-size: calc(var(--fs) * 0.92); color: var(--muted); margin-top: calc(var(--fs) * 0.5); }
  .header .contact span { margin-right: calc(var(--fs) * 1.14); }
  .profile-photo { width: calc(var(--fs) * 6.2); height: calc(var(--fs) * 7.6); flex: 0 0 auto; object-fit: cover; border: 1px solid var(--line); }
  .section { margin-bottom: calc(var(--fs) * 1.2); }
  .section-title { font-size: calc(var(--fs) * 1.12); font-weight: 700; color: var(--accent); background: var(--accent-soft); border-radius: calc(var(--fs) * 0.4); padding: calc(var(--fs) * 0.3) calc(var(--fs) * 0.8); margin-bottom: calc(var(--fs) * 0.75); }
  .entry { margin-bottom: calc(var(--fs) * 0.85); }
  .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--fs); }
  .entry-head .title { font-size: calc(var(--fs) * 1.06); font-weight: 600; }
  .entry-head .meta { font-size: calc(var(--fs) * 0.92); color: var(--muted); white-space: nowrap; }
  .entry .sub { font-size: calc(var(--fs) * 0.92); color: var(--muted); margin: calc(var(--fs) * 0.14) 0 calc(var(--fs) * 0.28); }
  ul { padding-left: calc(var(--fs) * 1.4); }
  li { margin-bottom: calc(var(--fs) * 0.22); }
  li::marker { color: var(--accent); }
  .summary-text { font-size: var(--fs); }
  .skill-list { padding-left: 0; }
  .skill-list li { list-style: none; display: inline-block; background: #f0edfd; color: #6c5ce7; border-radius: 4px; padding: 0 calc(var(--fs) * 0.71); margin: 0 calc(var(--fs) * 0.57) calc(var(--fs) * 0.57) 0; font-size: calc(var(--fs) * 0.92); }
  @page { size: A4; margin: 0; }
  @media print {
    .section, .entry { break-inside: avoid; }
    /* 让背景色与边框在打印时保留：技能标签的底色/左侧色条就靠这句。 */
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
<body>
{% include "_resume_sections.j2" %}
{% include "_resume_fit_script.j2" %}
</body>
</html>
