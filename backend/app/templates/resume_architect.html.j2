<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data: blob:; style-src 'unsafe-inline'; script-src 'nonce-{{ csp_nonce }}'; base-uri 'none'; form-action 'none'" />
<title>{{ resume.name }} - {{ resume.job_intent }} - 简历</title>
<style>
  /* 架构师模板：深紫强调色、居中衬线标题，稳重舒展，适合架构师与技术管理岗位。 */
  :root {
    --text: #26223a;
    --muted: #6d6688;
    --line: #ddd8ea;
    --accent: #5b3a8c;
    --accent-soft: #f1edf8;
    --bg: #ffffff;
    --fs: calc({{ base_px }}px * var(--fit-scale, 1));
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    color: var(--text);
    background: var(--bg);
    font-size: var(--fs);
    line-height: 1.75;
    width: 210mm;
    height: {{ page_limit * 297 }}mm;
    padding: 16mm;
  }
  .header { display: flex; align-items: flex-start; gap: calc(var(--fs) * 1.5); border-bottom: 1px solid var(--accent); padding-bottom: calc(var(--fs) * 0.95); margin-bottom: calc(var(--fs) * 1.5); }
  .header-main { flex: 1; min-width: 0; }
  .header .name { font-size: calc(var(--fs) * 1.92); font-weight: 700; color: var(--accent); letter-spacing: 1px; }
  .name-extra { font-size: calc(var(--fs) * 0.93); font-weight: 400; color: var(--muted); }
  .header .intent { font-size: calc(var(--fs) * 1.02); color: var(--muted); margin-top: calc(var(--fs) * 0.28); }
  .header .contact { font-size: calc(var(--fs) * 0.9); color: var(--muted); margin-top: calc(var(--fs) * 0.5); }
  .header .contact span { margin-right: calc(var(--fs) * 1.14); }
  .profile-photo { width: calc(var(--fs) * 6); height: calc(var(--fs) * 7.8); flex: 0 0 auto; object-fit: cover; border: 1px solid var(--line); }
  .section { margin-bottom: calc(var(--fs) * 1.35); }
  .section-title { font-size: calc(var(--fs) * 1.11); font-weight: 700; color: var(--accent); border-bottom: 1px solid var(--line); padding-bottom: calc(var(--fs) * 0.28); margin-bottom: calc(var(--fs) * 0.8); text-align: center; }
  .entry { margin-bottom: calc(var(--fs) * 0.9); }
  .entry-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--fs); }
  .entry-head .title { font-size: calc(var(--fs) * 1.05); font-weight: 600; }
  .entry-head .meta { font-size: calc(var(--fs) * 0.9); color: var(--muted); white-space: nowrap; }
  .entry .sub { font-size: calc(var(--fs) * 0.9); color: var(--muted); margin: calc(var(--fs) * 0.14) 0 calc(var(--fs) * 0.28); }
  ul { padding-left: calc(var(--fs) * 1.4); }
  li { margin-bottom: calc(var(--fs) * 0.2); }
  li::marker { color: var(--accent); }
  .summary-text { font-size: var(--fs); }
  .skill-list { padding-left: 0; }
  .skill-list li { list-style: none; display: inline-block; border: 1px solid #5b3a8c; color: #5b3a8c; border-radius: 999px; padding: 0 calc(var(--fs) * 0.8); margin: 0 calc(var(--fs) * 0.57) calc(var(--fs) * 0.57) 0; font-size: calc(var(--fs) * 0.93); }
  @page { size: A4; margin: 0; }
  @media print {
    .section, .entry { break-inside: avoid; }
    /* 让背景色与边框在打印时保留：技能标签的底色/左侧色条就靠这句。 */
    * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
<body>
{% include "_resume_sections.j2" %}
{% include "_resume_fit_script.j2" %}
</body>
</html>
